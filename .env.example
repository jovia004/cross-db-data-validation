# Keep this file in the project root (same folder as run.py).
# Copy to .env and set the values below. Do not commit .env to git.
#
# Environment is selected by config/column_mapping.json "environment": "test" or "prod".
# Set the *_TEST and/or *_PROD variables for the environment(s) you use.

# --- Test environment ---
# Primary (SQL Server)
PRIMARY_DB_HOST_TEST=
PRIMARY_DB_PORT_TEST=1433
PRIMARY_DB_NAME_TEST=
PRIMARY_DB_USER_TEST=
PRIMARY_DB_PASSWORD_TEST=
# Shadow (PostgreSQL)
SHADOW_DB_HOST_TEST=
SHADOW_DB_PORT_TEST=5432
SHADOW_DB_NAME_TEST=
SHADOW_DB_USER_TEST=
SHADOW_DB_PASSWORD_TEST=

# --- Production environment ---
# Primary (SQL Server)
PRIMARY_DB_HOST_PROD=
PRIMARY_DB_PORT_PROD=1433
PRIMARY_DB_NAME_PROD=
PRIMARY_DB_USER_PROD=
PRIMARY_DB_PASSWORD_PROD=
# Shadow (PostgreSQL)
SHADOW_DB_HOST_PROD=
SHADOW_DB_PORT_PROD=5432
SHADOW_DB_NAME_PROD=
SHADOW_DB_USER_PROD=
SHADOW_DB_PASSWORD_PROD=
